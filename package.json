{
  "name": "revive",
  "productName": "Revive",
  "version": "0.1.0",
  "private": true,
  "description": "A calm home for everything you build with AI",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "prebuild": "npm run typecheck && npm run test",
    "build": "electron-vite build && npm run build:web",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.live.test.ts\" --exclude \"**/*.pty.test.ts\" && npm run test:pty",
    "test:e2e": "electron-vite build && npm run build:web && playwright test",
    "postinstall": "electron-rebuild -f -w node-pty",
    "test:live": "vitest run src/main/scanner/turn-limit.live.test.ts",
    "test:pty": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.pty.config.ts",
    "build:web": "vite build --config vite.web.config.ts"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^11.2.15",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "simple-git": "^4.0.1",
    "systeminformation": "^5.33.13",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  }
}
